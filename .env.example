# ============================================================
# FORTIVEX AI SALES AGENT - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# GEMINI AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite:///./fortivex.db

# CORS Settings
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Whisper.cpp Settings
WHISPER_MODEL_PATH=./whisper.cpp/models/ggml-base.en.bin
WHISPER_BINARY_PATH=./whisper.cpp/main

# Piper TTS Settings
PIPER_BINARY_PATH=./piper/piper
PIPER_MODEL_PATH=./piper/en_US-lessac-medium.onnx

# Demo Mode (set to true if no Gemini API key)
DEMO_MODE=false

# Company Configuration (customize for your demo)
COMPANY_NAME=NovaTech Solutions
COMPANY_INDUSTRY=Enterprise Software
AGENT_NAME=Aria
